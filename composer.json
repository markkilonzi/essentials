{
	"name": "nyumbani/essentials",
	"type": "library",
	"description": "Opinionated helpers, services, UIs, packages, and AI skills and rules that define how every Nyumbani internal app looks and is structured.",
	"homepage": "https://nyumbanitech.co.ke/",
	"keywords": [
		"laravel",
		"nyumbani",
		"essentials"
	],
	"license": "proprietary",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"authors": [
		{
			"name": "Alvin Kaburu",
			"email": "geekaburu@nyumbanitech.co.ke"
		}
	],
	"require": {
		"php": "^8.3",
		"amprest/dt-tables": "^2.06",
		"lab404/laravel-impersonate": "^1.7",
		"laravel/fortify": "^1.41",
		"livewire/livewire": "^4.4",
		"nyumbani/daraja": "@dev",
		"nyumbani/messaging": "@dev",
		"spatie/laravel-activitylog": "^5.1",
		"spatie/laravel-permission": "^8.3"
	},
	"autoload": {
		"psr-4": {
			"Nyumbani\\Essentials\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Nyumbani\\Essentials\\EssentialsServiceProvider"
			]
		}
	},
	"require-dev": {
		"laravel/boost": "^2.2",
		"laravel/pail": "^1.2.5",
		"laravel/pint": "^1.27",
		"pestphp/pest": "^5.3",
		"pestphp/pest-plugin-laravel": "^5.0"
	}
}
